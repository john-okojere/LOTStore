# Copy to .env on the server and fill in real values. Never commit .env.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=store.layersoftruth.org
CSRF_TRUSTED_ORIGINS=https://store.layersoftruth.org
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
LOG_LEVEL=WARNING

# Storage (paths must match the nginx aliases in deploy/nginx-lot-store.conf)
SQLITE_PATH=
STATIC_ROOT=
MEDIA_ROOT=
USE_MYSQL=False
USE_S3=False

# Payments (use the live keys in production)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Email. Without EMAIL_HOST, emails (password resets, order confirmations) are only printed to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=store@layersoftruth.org
SERVER_EMAIL=store@layersoftruth.org
ADMIN_EMAIL=store@layersoftruth.org
