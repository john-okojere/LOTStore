# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.py.class

# Django migrations ARE committed: production must apply the same
# migration history that was used to build its schema.

# Virtual Environments
env/
venv/
ENV/
.venv/
.ENV/

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Generated
.DS_Store
Thumbs.db

# Logs & local stuff
*.log
*.pot
*.mo
*.sqlite3
db.sqlite3

# MySQL dumps
*.sql

# Media (user uploads) & collected static output.
# Source static files (user/static/) ARE committed.
media/
staticfiles/

# Secrets & Configs (any .env variant or backup; only the example is committed)
.env
.env.*
!.env.example
*.bak
*.bak-*
*.tmp

# Coverage & Testing
htmlcov/
.tox/
.coverage
.cache/
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# PyCharm
*.iml
*.ipr
*.iws
.idea/

# pip-tools
*.txt~
requirements-*.txt

# Others
*.swp
*.swo
