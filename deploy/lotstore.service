[Unit]
Description=Layers of Truth Store Django application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/digihosting/Documents/Apzs/LotStore/LOTStore
EnvironmentFile=/home/digihosting/Documents/Apzs/LotStore/LOTStore/.env
ExecStart=/home/digihosting/Documents/Apzs/LotStore/LOTStore/.venv/bin/gunicorn --workers 3 --timeout 120 --bind 127.0.0.1:8065 store.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
